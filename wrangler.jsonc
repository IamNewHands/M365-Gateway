{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m365-gateway-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["enable_request_signal"],
  // API turns spend most of their wall time waiting for Microsoft ChatHub;
  // let Cloudflare learn the lowest-latency Worker location while static
  // Assets remain edge-served by the selective run_worker_first rules below.
  "placement": { "mode": "smart" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    // Keep authentication and API routes in the Worker, while allowing the
    // static dashboard assets to use Cloudflare's asset CDN directly.  The
    // previous `true` value sent every asset request through the Worker,
    // consuming free Worker invocations/CPU and adding avoidable latency.
    "run_worker_first": ["/", "/index.html", "/login", "/login.html", "/api/*", "/v1/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Optional cold archive. Leave this block absent unless an R2 bucket has
  // already been created in the same Cloudflare account; the Worker remains
  // fully functional without it. The deploy helper accepts --archive-bucket
  // and adds this binding to its temporary, account-pinned config.
  // "r2_buckets": [{ "binding": "R2_ARCHIVE", "bucket_name": "m365-gateway-cf2-archive" }],
  "kv_namespaces": [
    {
      "binding": "SENSITIVE_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TENANTS", "class_name": "TenantState" },
      { "name": "CHATS", "class_name": "ChatSession" },
      { "name": "INFERENCE", "class_name": "InferenceGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TenantState", "ChatSession"] },
    { "tag": "v2", "new_sqlite_classes": ["InferenceGateway"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TENANT_NAME": "default",
    "MAX_ACCOUNTS": "40",
    "MIGRATION_ENABLED": "false",
    "MIGRATION_CANDIDATE_TAG": "account-migration-candidate",
    "DIRECT_NATIVE_TOOL_MODE": "true",
    "M365_CLIENT_ID": "00000000-0000-4000-8000-000000000001",
    "M365_AUTHORITY": "https://login.microsoftonline.com/common",
    "M365_REDIRECT_URI": "https://login.microsoftonline.com/common/oauth2/nativeclient",
    "M365_SCOPE": "openid profile offline_access https://substrate.office.com/sydney/M365Chat.Read https://substrate.office.com/sydney/sydney.readwrite"
  },
  "secrets": {
    "required": ["DATA_ENCRYPTION_KEY", "BOOTSTRAP_ADMIN_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 */2 * * *"]
  }
}

